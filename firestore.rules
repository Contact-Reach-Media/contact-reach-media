rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && (
          request.auth.token.email == 'contactreachmedialimited@gmail.com' ||
          request.auth.token.email == 'umuhuzamarket@gmail.com' ||
          request.auth.token.email == 'manirihocoss@gmail.com' ||
          request.auth.token.email == 'manirihothierry250@gmail.com' ||
          request.auth.token.email == 'manirihothierry36@gmail.com' ||
          request.auth.token.email == 'manirihothierry6@gmail.com' ||
          request.auth.token.email == 'manirihothierry11@gmail.com' ||
          request.auth.token.email.matches('.*@contactreachmedia\\.rw$')
        )) ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Products: readable by everyone, writable by admins
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: readable by everyone, writable by admins
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shops: readable by everyone, writable by admins
    match /shops/{shopId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Supplier applications: anyone can submit, admins can read and update
    match /supplierApplications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Orders: creation restricted to New/Pending Payment, listing restricted to admins, single order read restricted to admins or verified customer owner
    match /orders/{orderId} {
      allow create: if request.resource.data.status == 'New' && request.resource.data.paymentStatus == 'Pending Payment' && request.resource.data.totalAmount >= 0;
      allow list: if isAdmin();
      allow get: if isAdmin() || (isSignedIn() && (
        (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
        (resource.data.customerEmail != null && request.auth.token.email_verified == true && resource.data.customerEmail == request.auth.token.email)
      ));
      allow update, delete: if isAdmin();
    }

    // Payments: customer can create confirmation, admin can review
    match /payments/{paymentId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Refunds: readable and manageable by admins
    match /refunds/{refundId} {
      allow read, write: if isAdmin();
    }

    // Deliveries: readable by admins
    match /deliveries/{deliveryId} {
      allow read, write: if isAdmin();
    }

    // Supplier payouts: readable and manageable by admins
    match /supplierPayouts/{payoutId} {
      allow read, write: if isAdmin();
    }

    // Coupons: readable by everyone, writable by admins
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupon redemptions: anyone can create during checkout, admin can inspect
    match /couponRedemptions/{redemptionId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Inventory logs: admins only
    match /inventoryLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Audit logs: admins only
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Users: users can read/write their own profile, admin can manage
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // Admins profile table: admins can read/write; authenticated admins can read their record
    match /admins/{adminUid} {
      allow read: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow write: if isAdmin();
    }

    // Customer contact messages: anyone can submit, admins can read/reply
    match /messages/{messageId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Customer problem reports: anyone can submit, admins can review/manage
    match /customerProblems/{problemId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Product reviews: readable by all, authenticated users or buyers can create, admins can moderate
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // App Settings: readable by anyone, writable by admins
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
