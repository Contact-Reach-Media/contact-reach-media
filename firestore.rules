rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Products: allow create, read, update, delete
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories: allow create, read, update, delete
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Shops: allow create, read, update, delete
    match /shops/{shopId} {
      allow read, write: if true;
    }

    // Orders: allow create, read, update, delete
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Payments: allow create, read, update, delete
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    match /paymentConfirmations/{paymentId} {
      allow read, write: if true;
    }

    // Users and Customers: allow create, read, update, delete
    match /users/{userId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Messages and Chats: allow create, read, update, delete
    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /chats/{chatId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Customer problems: allow create, read, update, delete
    match /customerProblems/{problemId} {
      allow read, write: if true;
    }

    // Supplier applications and payouts: allow create, read, update, delete
    match /supplierApplications/{applicationId} {
      allow read, write: if true;
    }

    match /supplierPayouts/{payoutId} {
      allow read, write: if true;
    }

    // Coupons and Redemptions: allow create, read, update, delete
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    match /couponRedemptions/{redemptionId} {
      allow read, write: if true;
    }

    // Reviews: allow create, read, update, delete
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // App Settings: allow create, read, update, delete
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Administrators: allow create, read, update, delete
    match /admins/{adminUid} {
      allow read, write: if true;
    }

    match /adminUsers/{adminUid} {
      allow read, write: if true;
    }

    // Inventory and Audit logs: allow create, read, update, delete
    match /inventoryLogs/{logId} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Deliveries and Refunds: allow create, read, update, delete
    match /deliveries/{deliveryId} {
      allow read, write: if true;
    }

    match /refunds/{refundId} {
      allow read, write: if true;
    }

    // Universal match fallback allowing all data, users, and messages to be stored, edited, and deleted
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
